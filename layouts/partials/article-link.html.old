<div class="flex items-center gap-2 flex-wrap">
  <h3 class="text-lg font-semibold">
    <a href="{{ .RelPermalink }}" class="hover:underline text-neutral-800 dark:text-neutral-200">
      {{ .Title }}
    </a>
  </h3>

  {{ if .Params.new }}
    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-primary-500/10 text-primary-600 dark:bg-primary-400/10 dark:text-primary-400 border border-primary-500/20">
      Nouveau
    </span>
  {{ end }}
</div>
